@echo off
chcp 65001 > nul
rem Кодировка вывода. `chcp 65001` выше делает UTF-8 консоль, но при
rem перенаправлении в файл Python берёт кодировку из локали — и на машине
rem с западной кодовой страницей (cp1252) русский текст уходит в файл
rem сплошными «?»: на живом прогоне 29 сентября их было 3345. Движок
rem чинит это и сам (`compat.консоль`), здесь — на случай, если кто-то
rem запустит питон в обход наших точек входа.
set PYTHONIOENCODING=utf-8
rem Поднять стенд на Windows. Откроется http://localhost:8000
rem
rem   запустить.bat                 три участка
rem   запустить.bat 8001            другой порт, если 8000 занят
rem
rem Живьём на Windows не проверялось: машины не было.
setlocal
cd /d "%~dp0"

rem Запущен двойным щелчком — окно закроется вместе с программой, и
rem человек не успеет прочесть, что случилось. Тогда держим его открытым.
set HOLD=
rem Ищем ".bat", а не "%~nx0": имя файла кириллическое, а через
rem трубу оно уходит в find.exe двумя разными дорогами — аргументом
rem и байтами stdin. Совпадут они не на всякой сборке, и промах тут
rem молчаливый: HOLD не выставится, окно захлопнется вместе с
rem сообщением об ошибке. В интерактивном cmd в %cmdcmdline% лежит
rem только путь к cmd.exe, ".bat" там нет — различение сохраняется.
echo %cmdcmdline% | find /i ".bat" > nul && set HOLD=1

set PORT=%~1
if "%PORT%"=="" set PORT=8000

where py > nul 2>&1
if errorlevel 1 (
  echo.
  echo   Не нашёл "py". Поставьте Python 3.10 или новее с python.org.
  echo   Команда "python3" в Windows не работает: она открывает Microsoft Store.
  echo.
  if defined HOLD pause
  exit /b 1
)

echo Стенд поднимается на порту %PORT%. Закройте это окно, чтобы остановить.
echo Интерфейс: http://localhost:%PORT%
echo.
rem Участки передаются как "all", латиницей, а не тремя русскими именами:
rem через cmd.exe кириллица в аргументе зависит от кодовой страницы
rem консоли, а проверить это нам негде. Внутри "all" раскрывается в те же
rem «восток, юго-восток, югоцентр».
py -3 -m vrptw.server %PORT% all
set CODE=%errorlevel%
if defined HOLD pause
exit /b %CODE%
